# Bond — Mobile app environment variables
# Copy this file to `.env` and fill in your Supabase project values.
#
#   cp .env.example .env
#
# Get these from your Supabase project: Dashboard → Settings → API.
#
# IMPORTANT
# ---------
# - Prefix MUST be `EXPO_PUBLIC_` so Expo exposes them to the app bundle.
# - The anon (public) key is safe to ship in a client app, but it is NOT a
#   secret — your security relies on RLS policies, not on hiding this key.
# - NEVER put the service_role key in a client app. It bypasses RLS.

# Example (replace with your real project):
# https://YOUR-REF.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Your project's anon public key
EXPO_PUBLIC_SUPABASE_ANON_KEY=
