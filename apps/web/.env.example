# Bond — Web companion environment variables
# Copy to `.env` and fill in your Supabase project values.
#   cp .env.example .env
#
# Get these from Supabase: Dashboard → Settings → API.
# Prefix MUST be `VITE_` so Vite exposes them to the browser.
#
# The anon key is NOT a secret — real security comes from RLS policies.
# NEVER put the service_role key in a web client.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
