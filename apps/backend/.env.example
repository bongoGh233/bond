# Bond — Backend (Supabase) environment variables
#
# These are used by the Supabase CLI for LOCAL development (Docker). If you are
# connecting to a hosted cloud project from the apps, you don't need a local
# backend — just configure the app's .env with the cloud project URL + anon key.
#
#   npx supabase start          # starts local Postgres + CLI services
#   npx supabase db reset       # applies migrations + seed
#
# Leave as-is for local dev. `supabase start` prints a local URL and anon key
# that you can copy into apps/mobile/.env (and apps/web/.env).

# These are the defaults `supabase start` generates. You rarely need to change them.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<generated-by-supabase-start>

# ---------------------------------------------------------------------------
# Push notifications (Edge Functions)
# ---------------------------------------------------------------------------
# The process-push-outbox Edge Function flushes the `push_outbox` table through
# the Expo push service. Configure these as FUNCTION SECRETS, not client env:
#
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
#   supabase secrets set EXPO_ACCESS_TOKEN=<expo-access-token>  # optional, from expo.dev
#
# EXPONENTIAL_BACKOFF and MAX attempts are baked into the function itself.
# You can trigger it from a cron job calling the function URL, or schedule it
# with `pg_cron` — see apps/backend/docs/architecture.md.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key - do not commit>
EXPO_ACCESS_TOKEN=<optional-expo-push-access-token>
